{
  "name": "my-bangumi-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "基于 Bangumi 的本地对话 CLI Agent",
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "bin": {
    "my-bangumi-assistant": "dist/src/cli/main.js",
    "bangumi-agent": "dist/src/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/cli/main.js",
    "bgm": "node node_modules/@aronnaxlin/bgm-cli/src/cli.js"
  },
  "dependencies": {
    "@aronnaxlin/bgm-cli": "1.1.2",
    "ink": "7.1.1",
    "marked": "17.0.1",
    "playwright-core": "1.63.0",
    "react": "19.2.0",
    "string-width": "8.1.0",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.2.0",
    "typescript": "5.9.3"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KasLee14/MyBangumiAssistant.git"
  },
  "homepage": "https://github.com/KasLee14/MyBangumiAssistant#readme",
  "bugs": {
    "url": "https://github.com/KasLee14/MyBangumiAssistant/issues"
  }
}
